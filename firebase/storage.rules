rules_version = '2';
// Omni — storage.rules. Omni keeps profile pictures as small images inside
// Firestore, so it doesn't need Cloud Storage (which needs the paid "Blaze"
// plan on new projects). If you turn Storage on later, these rules only let
// you upload your own small picture into avatars/<your id>/.
service firebase.storage {
  match /b/{bucket}/o {
    match /avatars/{uid}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 200 * 1024
        && request.resource.contentType.matches('image/(webp|jpeg|png)');
    }
    match /{everything=**} { allow read, write: if false; }
  }
}
