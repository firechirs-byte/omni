{
  "name": "omni",
  "productName": "Omni",
  "version": "4.3.0",
  "private": true,
  "description": "Omni desktop shell. The website in this folder stays the GitHub Pages app.",
  "main": "desktop/main.js",
  "author": "Omni",
  "scripts": {
    "start": "electron .",
    "test": "node --test desktop/policy.test.js",
    "smoke": "electron . --omni-self-test",
    "pack:win": "electron-builder --win nsis portable --x64",
    "pack:win:zip": "electron-builder --win zip --x64"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.firechirs-byte.omni",
    "productName": "Omni",
    "asar": true,
    "npmRebuild": false,
    "compression": "normal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "index.html",
      "styles.css",
      "manifest.webmanifest",
      "icon.svg",
      "*.js",
      "!sw.js",
      "fonts/**",
      "icons/**",
      "gifs/**",
      "desktop/main.js",
      "desktop/policy.js",
      "desktop/picker-preload.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icons/icon-512.png",
      "signAndEditExecutable": true,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Omni",
      "artifactName": "Omni-${version}-setup.exe",
      "uninstallDisplayName": "Omni"
    },
    "portable": {
      "artifactName": "Omni-${version}-portable.exe"
    }
  }
}
